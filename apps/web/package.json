    "@msk-forms/db": "workspace:*",
    "@msk-forms/shared": "workspace:*",
    "@msk-forms/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "iron-session": "^9.0.1",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
