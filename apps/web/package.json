{
  "name": "@msk-forms/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/assert-build-env.mjs && next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start --port 3000",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .next .turbo dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@msk-forms/db": "workspace:*",
    "@msk-forms/shared": "workspace:*",
    "@msk-forms/ui": "workspace:*",
    "@radix-ui/react-slot": "^1.3.3",
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "iron-session": "^9.0.1",
    "next": "^16.3.5",
    "next-themes": "^0.4.4",
    "nodemailer": "^9.1.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
