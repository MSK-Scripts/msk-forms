{
  "name": "@msk-forms/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/assert-build-env.mjs && next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start --port 3000",
